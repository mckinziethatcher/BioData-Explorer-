install.packages("shiny")
library(shiny)
ui <- fluidPage(
titlePanel("BioData Explorer"),
h3("Upload a biological dataset"),
fileInput(
"dataset",
"Choose a file",
accept = c(
".csv",
".tsv",
".txt"
)
),
hr(),
h3("Dataset Preview"),
tableOutput("preview")
)
server <- function(input, output, session) {
dataset <- reactive({
req(input$dataset)
file_extension <- tools::file_ext(
input$dataset$name
)
if (file_extension == "csv") {
data <- read.csv(
input$dataset$datapath,
stringsAsFactors = FALSE
)
} else if (
file_extension %in% c("tsv", "txt")
) {
data <- read.delim(
input$dataset$datapath,
stringsAsFactors = FALSE
)
} else {
stop("Unsupported file type")
}
data
})
output$preview <- renderTable({
head(
dataset(),
10
)
})
}
shinyApp(
ui = ui,
server = server
)
runApp()
library(shiny)
ui <- fluidPage(
titlePanel("BioData Explorer"),
h3("Upload a biological dataset"),
fileInput(
"dataset",
"Choose a file",
accept = c(
".csv",
".tsv",
".txt"
)
),
hr(),
h3("Dataset Summary"),
verbatimTextOutput("dataset_summary"),
hr(),
h3("Column Information"),
tableOutput("column_info"),
hr(),
h3("Dataset Preview"),
tableOutput("preview")
)
server <- function(input, output, session) {
# ---------------------------
# Read uploaded dataset
# ---------------------------
dataset <- reactive({
req(input$dataset)
file_extension <- tolower(
tools::file_ext(input$dataset$name)
)
if (file_extension == "csv") {
data <- read.csv(
input$dataset$datapath,
stringsAsFactors = FALSE,
check.names = FALSE
)
} else if (
file_extension %in% c("tsv", "txt")
) {
data <- read.delim(
input$dataset$datapath,
stringsAsFactors = FALSE,
check.names = FALSE
)
} else {
stop("Unsupported file type")
}
data
})
# ---------------------------
# Dataset summary
# ---------------------------
output$dataset_summary <- renderText({
data <- dataset()
rows <- nrow(data)
columns <- ncol(data)
missing_values <- sum(is.na(data))
duplicate_rows <- sum(duplicated(data))
numeric_columns <- sum(
sapply(data, is.numeric)
)
text_columns <- sum(
sapply(data, is.character)
)
paste0(
"Rows: ", rows, "\n",
"Columns: ", columns, "\n\n",
"Numeric columns: ",
numeric_columns, "\n",
"Text columns: ",
text_columns, "\n\n",
"Missing values: ",
missing_values, "\n",
"Duplicate rows: ",
duplicate_rows
)
})
# ---------------------------
# Column information
# ---------------------------
output$column_info <- renderTable({
data <- dataset()
column_names <- names(data)
column_types <- sapply(
data,
function(x) class(x)[1]
)
missing_values <- sapply(
data,
function(x) sum(is.na(x))
)
unique_values <- sapply(
data,
function(x) length(unique(x))
)
data.frame(
Column = column_names,
Type = column_types,
Missing = missing_values,
Unique_Values = unique_values
)
})
# ---------------------------
# Dataset preview
# ---------------------------
output$preview <- renderTable({
head(
dataset(),
10
)
})
}
shinyApp(
ui = ui,
server = server
)
runApp()
